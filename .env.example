# ProofOfBalance configuration. Copy to .env and fill in. .env is git-ignored.
# scripts/setup.sh reads this file; anything already exported in your shell wins.

# --- AWS (required for scripts/setup.sh / teardown.sh) -------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS/SSO) credentials:
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1

# --- Terraform -------------------------------------------------------------------
# Globally unique S3 bucket for state. Empty = pob-tfstate-<your account id>.
TF_STATE_BUCKET=
# Public IPv4(s) allowed to SSH / reach the k3s API, each as a /32. Comma-separate several.
# Empty = auto-detect on every run, including networks that rotate between several public IPs.
MY_IP=
# Needs >= 4 GB. On an AWS *Free plan* account only Free-Tier types launch; setup.sh then
# switches automatically to m7i-flex.large (2 vCPU, 8 GB, Free-Tier eligible).
INSTANCE_TYPE=t3.medium
MONTHLY_BUDGET_USD=10
# Budget alert emails (80% actual / 100% forecast). Empty = budget without alerts.
BUDGET_ALERT_EMAIL=
OWNER_TAG=Akshith1413
ENVIRONMENT_TAG=demo
GITHUB_REPO=Akshith1413/ProofOfBalance

# --- Application images ------------------------------------------------------------
# local = build on this machine and copy into k3s over SSH (needs Docker; no registry).
# ghcr  = pull ghcr.io/<owner>/proofofbalance-{service,rail}:IMAGE_TAG (pushed by build.yml).
IMAGE_SOURCE=local
IMAGE_TAG=latest
# Only for IMAGE_SOURCE=ghcr with private packages (a token with read:packages):
GHCR_USERNAME=
GHCR_TOKEN=

# --- Secrets for the cluster (empty = generated once, saved in .secrets/generated.env) --
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- Alert routing (optional; leave both empty to keep alerts inside Alertmanager) -----
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts

# --- GitHub automation (optional) ---------------------------------------------------
# A fine-grained token with Administration + Variables (read/write) on the repo lets
# setup.sh set the Actions variables, create the update-baseline label and protect main.
GITHUB_TOKEN=
